# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://uoxzfxpumhqhflxqscui.supabase.co
# "Publishable key" (sb_publishable_...) эсвэл хуучин "anon" key — аль нь ч болно
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Үндсэн домэйн. Хөгжүүлэлтэд localhost:3000, production-д hhk.mn
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Төлбөрийн имэйл мэдэгдэл (заавал биш). Resend → API Keys. Тохируулаагүй бол мэдэгдэл явуулахгүй.
RESEND_API_KEY=
MAIL_FROM=hhk.mn <noreply@hhk.mn>

# Түр нууц үгтэй ажилтан урихад хэрэгтэй (Supabase → Project Settings → API → service_role). ХЭЗЭЭ Ч NEXT_PUBLIC_ угтвар бүү тавь, хөтчид бүү гаргуул.
SUPABASE_SERVICE_ROLE_KEY=

# Push мэдэгдэл (заавал биш). Түлхүүр үүсгэх: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:erdenebilegamgalan@gmail.com
